# Python
# ========================
# Byte-code files
*.pyc
__pycache__/
*.pyd
*.pyo

# Distribution / Packaging
*.egg-info/
.eggs/
dist/
build/
sdist/
wheel/
*.egg
PKG-INFO

# Virtual Environment
# ========================
# Ignore the virtual environment itself.
# Your project's dependencies should be listed in requirements.txt or pyproject.toml
# and installed by creating a new venv.
venv/
.venv/
env/
.env/
.python-version
pip-wheel-metadata/

# Dependency Management (e.g., Pip, Poetry, Conda)
# ========================
# Pip cache
pip-selfcheck.json

# Conda environment file, if generated locally and not intended for sharing
# or if you use `conda activate myenv` without exporting
# environment.yml # UNCOMMENT if you generate this locally and don't want to commit it

# Poetry lock file - usually committed, but if you have a reason not to
# poetry.lock # UNCOMMENT if you don't want to commit poetry.lock

# Operating System Files
# ========================
.DS_Store # macOS
.Trashes # macOS
ehthumbs.db # Windows
Thumbs.db # Windows
Desktop.ini # Windows
*.fuse_hidden* # Linux
.nfs* # Linux

# IDE / Editor Files
# ========================
# PyCharm / IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# VS Code
.vscode/
# Add this if you want to ignore all user-specific settings,
# but sometimes parts of .vscode (e.g., launch.json, settings.json for workspace)
# are useful to commit. Use caution.
# .vscode/*
# !.vscode/settings.json # Example exception if you only ignore other things
# !.vscode/extensions.json
# !.vscode/launch.json
# !.vscode/tasks.json

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo

# Emacs
*~
#*#

# Jupyter Notebook
# ========================
.ipynb_checkpoints/
# Jupyter notebook specific output files, if you have any
.jupyter/

# Test / Coverage
# ========================
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml

# MyPy / Type Hinting
# ========================
.mypy_cache/

# Ruff (Linter/Formatter)
# ========================
.ruff_cache/

# Sphinx Documentation
# ========================
docs/_build/

# Miscellaneous
# ========================
# Logs
*.log
*.log.[0-9]*
tmp/
.gitkeep # Generally not needed, but sometimes used for empty folders

# Database files (e.g., for Django/Flask development)
*.sqlite3
*.db
db.sqlite3

# Environment variables files (IMPORTANT: Do NOT commit sensitive data!)
.env
.flaskenv
.vaultenv
.secrets
secrets.py # If you have a separate file for secrets, ensure it's ignored!

# Cloud / Platform specific files
# ========================
# Google App Engine
# .gcloudignore is often used instead of .gitignore for GAE deployment.
# If you are using GAE, make sure to configure .gcloudignore properly.

# Serverless Framework
.serverless/

# Docker
.dockerignore # This file itself should be committed
# If you have locally generated Docker-related files:
docker-compose.override.yml # If you're using this for local dev and not for production
*.tmp.dockerfile

# Terraform
.terraform/
.terraform.lock.hcl
*.tfplan
*.tfstate
*.tfstate.backup

# Generated output files
# ========================
# Often generated by scripts or data processing
output/
data/*.pickle
data/*.pkl
data/*.csv # If these are generated, not source data

# Mac OS X
._*
.DS_Store
__MACOSX

# Project specific
test.py

